@@ -0,0 +1,92 @@
+use async_trait::async_trait;
+use cua_driver_core::{
+    protocol::ToolResult,
+    tool::{Tool, ToolDef},
+};
+use serde_json::Value;
+use std::sync::Arc;
+
+use super::ToolState;
+
+pub struct FocusTool {
+    state: Arc<ToolState>,
+}
+
+impl FocusTool {
+    pub fn new(state: Arc<ToolState>) -> Self {
+        Self { state }
+    }
+}
+
+static DEF: std::sync::OnceLock<ToolDef> = std::sync::OnceLock::new();
+
+fn def() -> &'static ToolDef {
+    DEF.get_or_init(|| ToolDef {
+        name: "focus".into(),
+        description: "Set AXFocused=true on an element_token without pressing it. Pure AX: no keys, no cursor, no activation. Useful before paste (clipboard + Cmd+V) or typing into a field that does not accept AXPress."
+            .into(),
+        input_schema: serde_json::json!({
+            "type": "object",
+            "required": ["element_token"],
+            "properties": {
+                "session": { "type": "string", "description": "For multi-call work, prefer a short public session label and repeat it on every call that accepts it." },
+                "element_token": cua_driver_core::tool_schema::element_token_schema(),
+                "pid": { "type": "integer", "description": "Target process ID. Optional with element_token (the token carries the pid)." },
+                "window_id": { "type": "integer", "description": "CGWindowID. Optional with element_token." }
+            }
+        }),
+        read_only: false,
+        destructive: false,
+        idempotent: true,
+        open_world: false,
+    })
+}
+
+#[async_trait]
+impl Tool for FocusTool {
+    fn def(&self) -> &ToolDef {
+        def()
+    }
+
+    async fn invoke(&self, args: Value) -> ToolResult {
+        use cua_driver_core::tool_args::ArgsExt;
+
+        let pid = match super::target_pid(&self.state, &args) {
+            Ok(v) => v,
+            Err(e) => return e,
+        };
+        let window_id_arg = args.opt_u64("window_id");
+        let resolved = match self.state.snapshots.resolve(pid, &args) {
+            Ok(r) => r,
+            Err(e) => return e,
+        };
+        let (_, _, element_guard) = resolved.into_parts(window_id_arg);
+        let Some(guard) = element_guard else {
+            return ToolResult::error("focus requires an element_token");
+        };
+        let ptr = guard.as_ptr();
+
+        let result = tokio::task::spawn_blocking(move || -> anyhow::Result<()> {
+            let deadline = std::time::Instant::now() + std::time::Duration::from_millis(400);
+            loop {
+                crate::input::ax_actions::focus_element(ptr)?;
+                if crate::input::ax_actions::is_element_focused(pid, ptr) {
+                    return Ok(());
+                }
+                if std::time::Instant::now() >= deadline {
+                    anyhow::bail!("requested element did not become focused");
+                }
+                std::thread::sleep(std::time::Duration::from_millis(20));
+            }
+        })
+        .await;
+
+        match result {
+            Ok(Ok(())) => ToolResult::text("Focused element via AX.").with_structured(
+                serde_json::json!({ "path": "ax", "effect": "confirmed" }),
+            ),
+            Ok(Err(e)) => ToolResult::error(format!("focus failed: {e}")),
+            Err(e) => ToolResult::error(format!("focus task failed: {e}")),
+        }
+    }
+}
