+        let arguments = std::env::args_os().skip(1).collect();
+        runtime.block_on(proxy::run_mcp_idle_supervisor(
+            executable,
+            arguments,
+            tools_list,
+            proxy::DIRECT_WORKER_ENV,
+            true,
+            envelope_mode,
+        ))
+    }
